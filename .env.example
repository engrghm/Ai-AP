# Claude API key — https://console.anthropic.com থেকে নিন
ANTHROPIC_API_KEY=sk-ant-...

# আপনার নাম (অ্যাসিস্ট্যান্ট আপনাকে এই নামে ডাকবে)
OWNER_NAME=Masum

# টাইমজোন
TIMEZONE=Asia/Dhaka

# প্রতিদিন সকালের ব্রিফিং কখন পাঠাবে (HH:MM, ফাঁকা রাখলে বন্ধ)
BRIEFING_TIME=08:00

# ডাটাবেস ফাইল (আপনার সব তথ্য এখানে থাকবে)
DB_PATH=data/assistant.db

# --- টেলিগ্রাম (ঐচ্ছিক, মোবাইলে রিমাইন্ডার পেতে) ---
# @BotFather থেকে বট বানিয়ে টোকেন দিন
TELEGRAM_BOT_TOKEN=
# শুধু এই চ্যাট আইডি বটের সাথে কথা বলতে পারবে (বটে /start দিলে আইডি দেখাবে)
TELEGRAM_OWNER_CHAT_ID=
